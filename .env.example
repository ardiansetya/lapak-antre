# Copy to .env and fill in. .env is git-ignored.

# Local MySQL 8. Create the database first: CREATE DATABASE lapak_antre;
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/lapak_antre"

# Production on TiDB Cloud Starter (MySQL-compatible, needs TLS):
# DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/lapak_antre?ssl=true"

# Dev server runs on 3100 (`npx next dev -p 3100`); this URL is printed on the QR poster.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
